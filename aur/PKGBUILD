# Maintainer: Peter <peternaame@gmail.com>
pkgname=ytm-player-git
pkgver=2.0.0
pkgrel=2
pkgdesc="A full-featured YouTube Music TUI client with vim-style navigation"
# The package ships the compiled Rust/PyO3 extension (built by build() below),
# so it is no longer architecture-independent. Match the platforms the PyPI
# binary wheels cover: manylinux x86_64 + aarch64.
arch=('x86_64' 'aarch64')
url="https://ytm-player.com"
license=('MIT')
depends=(
    'mpv'
    'python'
    'python-aiosqlite'
    'python-click'
    'python-dbus-fast>=5'
    'python-mpv'
    'python-packaging'
    'python-pillow'
    'python-pycryptodomex'
    'python-textual>=7.0'
    'python-textual<9.0'
    'python-ytmusicapi'
    'yt-dlp'
)
makedepends=('cargo' 'git' 'python-build' 'python-installer' 'python-hatchling')
optdepends=(
    'python-anyascii: lyrics transliteration to ASCII'
    'python-pylast: Last.fm scrobbling'
    'python-pypresence: Discord Rich Presence'
    'python-spotipy: Spotify playlist import (AUR)'
    'python-thefuzz: Spotify import fuzzy matching (AUR)'
)
provides=('ytm-player')
conflicts=('ytm-player')
# url is the package homepage (AUR display). source is the build fetch
# location — the Rust-transition repository that carries native/ (the
# upstream peternaame-boop/ytm-player master does not contain the Rust
# extension, so native/build.sh below would fail there). They intentionally
# differ. Do not collapse them via "git+${url}.git".
source=("git+https://github.com/E-Vex/ytm-player-RUST.git")
sha256sums=('SKIP')

pkgver() {
    cd ytm-player
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd ytm-player
    python -m build --wheel --no-isolation
    # Compile the Rust/PyO3 extension. build.sh resolves the per-platform
    # artifact and module names and copies the result into the source tree.
    # It cannot ride along in the wheel above: hatchling honours .gitignore
    # (which excludes *.so as build artifacts), so package() installs the
    # module beside the wheel's files instead — the exact path the package's
    # `from .utils._ytm_player_native import ...` sites import from.
    native/build.sh
}

package() {
    cd ytm-player
    python -m installer --destdir="$pkgdir" dist/*.whl
    local site_packages
    site_packages="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
    install -Dm755 src/ytm_player/utils/_ytm_player_native.abi3.so \
        "$pkgdir${site_packages}/ytm_player/utils/_ytm_player_native.abi3.so"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
